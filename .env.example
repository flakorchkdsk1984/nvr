# ==========================================
# C2L-Y-A NVR Configuration Template (.env.example)
# ==========================================

# Camera Settings
CAMERA_HOST=192.168.1.40
CAMERA_PORT=80
CAMERA_USER=admin
CAMERA_PASS=

# go2rtc Bridge Settings
GO2RTC_URL=http://127.0.0.1:1984
GO2RTC_RTSP=rtsp://127.0.0.1:8554

# Storage & Recordings
RECORDINGS_DIR=/home/chkdsk/c2l_nvr/recordings
THUMBS_DIR=/home/chkdsk/c2l_nvr/cache/thumbs
DATA_DIR=/home/chkdsk/c2l_nvr/data
SEGMENT_SECONDS=900
RETENTION_DAYS=7
MAX_DISK_USAGE_PERCENT=90

# Web Server & Authentication
PORT=8080
AUTH_USER=admin
# Generate hash with: node -e 'console.log(require("bcryptjs").hashSync("yourpassword", 10))'
AUTH_PASS_HASH=$2a$10$r2JgGUv9lK7rxZ24sP2cKeQJi1s18b8oLB/UD8D08SNSihPFADscu
JWT_SECRET=change_this_to_a_random_secret_in_production

# Binaries
FFMPEG_PATH=/home/chkdsk/bin/ffmpeg
FFPROBE_PATH=/home/chkdsk/bin/ffprobe
